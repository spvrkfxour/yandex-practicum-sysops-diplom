#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="{{ backup_fs_dir }}"
SSH_KEY="{{ backup_ssh_key_path }}"
SSH_USER="{{ backup_ssh_user }}"
APP_HOST="{{ backup_mediawiki_host }}"
MEDIAWIKI_PATH="{{ backup_mediawiki_path }}"
KEEP_DAYS="{{ backup_keep_days_fs }}"

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
BACKUP_FILE="${BACKUP_DIR}/mediawiki_${TIMESTAMP}.tar.gz"
LATEST_LINK="${BACKUP_DIR}/latest.tar.gz"

log() {
  echo "[$(date '+%F %T')] $*"
}

cleanup_old_backups() {
  find "${BACKUP_DIR}" -maxdepth 1 -type f -name "*.tar.gz" -mtime +"${KEEP_DAYS}" -delete
}

mkdir -p "${BACKUP_DIR}"

MW_PARENT="$(dirname "${MEDIAWIKI_PATH}")"
MW_BASENAME="$(basename "${MEDIAWIKI_PATH}")"

log "Starting MediaWiki filesystem backup from ${APP_HOST}:${MEDIAWIKI_PATH} ..."
ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no "${SSH_USER}@${APP_HOST}" \
  "REAL_PATH=\$(readlink -f '${MEDIAWIKI_PATH}') && \
  REAL_PARENT=\$(dirname \"\$REAL_PATH\") && \
  REAL_BASENAME=\$(basename \"\$REAL_PATH\") && \
  sudo tar -czf - -C \"\$REAL_PARENT\" \"\$REAL_BASENAME\"" > "${BACKUP_FILE}"

ln -sfn "${BACKUP_FILE}" "${LATEST_LINK}"

cleanup_old_backups

log "MediaWiki filesystem backup completed: ${BACKUP_FILE}"
