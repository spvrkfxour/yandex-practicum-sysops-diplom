upstream {{ nginx_lb_upstream_name }} {
  {% for host in groups['mediawiki_1'] | default([]) %}
    server {{ hostvars[host].private_ip }}:80;
  {% endfor %}
  {% for host in groups['mediawiki_2'] | default([]) %}
    server {{ hostvars[host].private_ip }}:80;
  {% endfor %}
}

server {
  listen {{ nginx_lb_listen_port }};
  server_name {{ nginx_lb_server_name }} _;

  location / {
    proxy_pass http://{{ nginx_lb_upstream_name }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
